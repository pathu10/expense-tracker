# Copy this file to .env and adjust values as needed.
# .env is used by docker-compose.yml and must never be committed.

# ---- Backend ----
PORT=5000

# ---- Database ----
# IMPORTANT: When running via Docker Compose, DB_HOST must be the
# Compose service name ("database"), NOT "localhost". Containers talk to
# each other over the Compose network using service names as hostnames.
DB_HOST=database
DB_PORT=5432
DB_NAME=expense_tracker
DB_USER=admin
DB_PASSWORD=password

# ---- Frontend ----
# URL the browser uses to reach the backend API. When running the whole
# stack with Docker Compose and exposing the backend on the host at 5000,
# this stays as localhost because it runs in the user's BROWSER, not
# inside a container.
VITE_API_URL=http://localhost:5000
